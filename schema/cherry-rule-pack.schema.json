{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cherrywaf.local/schema/cherry-rule-pack.schema.json",
  "title": "CherryRule Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "version",
        "title",
        "title_th",
        "description_th",
        "license",
        "target_rule_count",
        "requirements",
        "defaults",
        "references",
        "rules"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CHERRYRULE-[A-Z0-9-]+$"
        },
        "slug": {
          "type": "string",
          "pattern": "^[0-9]{2}-[a-z0-9-]+$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "title_th": {
          "type": "string",
          "minLength": 3
        },
        "description_th": {
          "type": "string",
          "minLength": 3
        },
        "license": {
          "type": "string"
        },
        "target_rule_count": {
          "type": "integer",
          "minimum": 1
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "defaults": {
          "type": "object",
          "required": [
            "mode",
            "status",
            "paranoia_level"
          ],
          "properties": {
            "mode": {
              "enum": [
                "score",
                "block",
                "challenge",
                "throttle",
                "sanitize",
                "redact"
              ]
            },
            "status": {
              "enum": [
                "experimental",
                "stable",
                "deprecated"
              ]
            },
            "paranoia_level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            }
          },
          "additionalProperties": true
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "uniqueItems": true
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          },
          "minItems": 1
        }
      }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "name_th",
        "description_th",
        "category",
        "phase",
        "engine",
        "targets",
        "operator",
        "transforms",
        "action",
        "severity",
        "confidence",
        "paranoia_level",
        "default_enabled",
        "status",
        "tags"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CWAF-[A-Z0-9-]+-[0-9]{6}$"
        },
        "name": {
          "type": "string",
          "minLength": 3
        },
        "name_th": {
          "type": "string",
          "minLength": 3
        },
        "description_th": {
          "type": "string",
          "minLength": 3
        },
        "category": {
          "type": "string",
          "pattern": "^[a-z0-9-]+(?:\\.[a-z0-9-]+)+$"
        },
        "phase": {
          "enum": [
            "connection",
            "request_headers",
            "request_uri",
            "request_body",
            "response_headers",
            "response_body"
          ]
        },
        "engine": {
          "enum": [
            "re2",
            "parser",
            "policy",
            "stateful",
            "schema",
            "token_parser",
            "file_inspector",
            "response_policy",
            "reputation",
            "dns_policy",
            "authorization",
            "graphql",
            "websocket",
            "grpc",
            "signature",
            "agent_gateway",
            "catalog",
            "deployment"
          ]
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "operator": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            },
            "pattern": {
              "type": "string"
            },
            "check": {
              "type": "string"
            },
            "params": {
              "type": "object"
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "regex"
                  }
                }
              },
              "then": {
                "required": [
                  "pattern"
                ]
              }
            }
          ]
        },
        "transforms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "action": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "score"
          ],
          "properties": {
            "mode": {
              "enum": [
                "score",
                "block",
                "challenge",
                "throttle",
                "sanitize",
                "redact",
                "allow"
              ]
            },
            "score": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "severity": {
          "enum": [
            "info",
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "paranoia_level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "default_enabled": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "experimental",
            "stable",
            "deprecated"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "false_positive_notes": {
          "type": "string"
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "scope": {
          "type": "object"
        }
      }
    }
  }
}
